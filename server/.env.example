# Qiji 管理端网关配置（复制为 .env 使用）

# 监听端口
PORT=8787

# 管理端控制台令牌（/admin 登录用），生产务必修改
ADMIN_TOKEN=admin-dev

# 首次启动若用户库为空，自动创建一个默认用户的 accessKey（之后在 /admin 里管理用户）
SEED_ACCESS_KEY=dev-key

# ── 上游聚合网关（g-aisc）──
# 一把 sk- 密钥、Bearer 鉴权，同时兼容 OpenAI / Anthropic / Gemini 三协议。
# 填了 GATEWAY_API_KEY 后，下面三协议默认全部走它；留空则只有 echo / 占位 可用。
GATEWAY_BASE_URL=https://sub.g-aisc.com
GATEWAY_API_KEY=

# 可选：分协议覆盖（不填则继承 GATEWAY_*）
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_API_KEY=
# GEMINI_BASE_URL=
# GEMINI_API_KEY=

# ── 简梦 JA 视频渠道（独立网关 + 独立 sk-；JA-sd2-* 视频模型用）──
# 不填 JIANMENG_API_KEY 视频生成会回退网关 key（多半不通），请填简梦自己的 sk-。
JIANMENG_BASE_URL=https://api.jian1.vip
JIANMENG_API_KEY=

# ── OSS 对象存储（S3 兼容；资产/项目云备份，公有读直链）──
# 不填则资产退回内存 + /v1/assets/:id/raw（进程重启即丢，仅联调用）。
OSS_ENDPOINT=https://cn-nb1.rains3.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_SECRET_ACCESS_KEY=
OSS_REGION=cn-nb1
# 可选：CDN/自定义域名（默认 https://<bucket>.<endpoint host>）
# OSS_PUBLIC_BASE=
