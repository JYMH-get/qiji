# Qiji 管理端网关配置（复制为 .env 使用）

# 监听端口
PORT=8787

# 管理端控制台令牌（/admin 登录用），生产务必修改
ADMIN_TOKEN=admin-dev

# 首次启动若用户库为空，自动创建一个默认用户的 accessKey（之后在 /admin 里管理用户）
SEED_ACCESS_KEY=dev-key

# ── 节点角色（P3 渠道商独立部署，详见 docs/渠道节点部署手册.md）──
# source（缺省）=源站：持上游密钥、翻译转发、统一定价——现行为，不用改。
# relay=渠道节点：渠道商自部署——本地只有用户体系（注册/积分/团队/日志），
#   生成与素材全部转发 SOURCE_URL 的源站，凭 SOURCE_NODE_KEY（源站渠道商详情生成的 ank- 密钥）
#   计费到该商在源站的积分池。relay 模式**不需要**配 OSS、不需要任何上游密钥。
# NODE_ROLE=relay
# SOURCE_URL=https://source.example.com
# SOURCE_NODE_KEY=ank-xxxxxxxx

# ── 上游提交安全闸（第169轮）──
# 提交/同步生成类上游请求已取消短超时（此前 60s 提交超时 = 上游已受理照扣费、我方判失败退款 = 纯亏损）。
# 只保留一个极长安全闸防死连接把任务挂死：缺省 1800000（30 分钟）；设 0 = 完全不设超时。
# 轮询/下载类请求不受影响（各自短超时+重试语义不变）。
# SUBMIT_TIMEOUT_MS=1800000

# ── 上游聚合网关（g-aisc）──
# 一把 sk- 密钥、Bearer 鉴权，同时兼容 OpenAI / Anthropic / Gemini 三协议。
# 填了 GATEWAY_API_KEY 后，下面三协议默认全部走它；留空则只有 echo / 占位 可用。
GATEWAY_BASE_URL=https://sub.g-aisc.com
GATEWAY_API_KEY=

# 可选：分协议覆盖（不填则继承 GATEWAY_*）
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_API_KEY=
# GEMINI_BASE_URL=
# GEMINI_API_KEY=

# ── 简梦 JA 视频渠道（独立网关 + 独立 sk-；JA-sd2-* 视频模型用）──
# 不填 JIANMENG_API_KEY 视频生成会回退网关 key（多半不通），请填简梦自己的 sk-。
JIANMENG_BASE_URL=https://api.jian1.vip
JIANMENG_API_KEY=

# ── 简梦P 视频渠道（Sora/Veo 系：sora2/sora-v3-*/veo31-*；第147轮）──
# ⚠ 上游文档未给 Base URL——两项均可留空、改在管理端「简梦P」渠道里配置（渠道优先于环境）。
# JIANMENGP_BASE_URL=
# JIANMENGP_API_KEY=

# ── 简梦M 视频渠道（MuseAI museai.vip：jmm 系 4 模型；第151轮；apikey 头鉴权，密钥 MUSE- 开头）──
# MUSEM_BASE_URL=https://museai.vip
# MUSEM_API_KEY=

# ── 简梦Z 渠道（zexitongxue.com：jmz 系 视频14+图片7 模型；第152/153轮；Bearer 鉴权）──
# ⚠ Base URL 填根域不带 /v1（翻译器自拼 /v1/videos、/v1/images/*）。
# JMZ_BASE_URL=https://zexitongxue.com
# JMZ_API_KEY=

# ── 简梦H 渠道（ZhengAPI zhengapi.top：jmh 系 图片6+视频9 模型；第154/155轮；Bearer 鉴权，同步/流式单请求）──
# JMH_BASE_URL=https://zhengapi.top
# JMH_API_KEY=

# ── 简梦T 视频渠道（llm.chre3.com：sd2-c8 · Seedance 2.0 满血版；第160轮；Bearer 鉴权）──
# ⚠ Base URL 填根域不带 /v1（翻译器自拼 /v1/videos）。
# JMT_BASE_URL=https://llm.chre3.com
# JMT_API_KEY=

# ── 简梦F 视频渠道（new.vosle.xyz：Seedance 2.0，模型 ID 现拼 比例/时长；第161轮；Bearer 鉴权）──
# ⚠ Base URL 填根域不带 /v1（翻译器自拼 /v1/videos）；成片下载须带同一密钥（服务端转存 OSS 已自动带）。
# JMF_BASE_URL=https://new.vosle.xyz
# JMF_API_KEY=

# ── 出海营 视频渠道（api.aiid.edu.kg：Seedance 任务格式，doubao-seedance 2.0 系/sd-2-5/gemini-omni；第186轮；Bearer 鉴权）──
# ⚠ Base URL 填根域（翻译器自拼 /api/v3/contents/generations/tasks）。
# OVERSEAS_BASE_URL=https://api.aiid.edu.kg
# OVERSEAS_API_KEY=

# ── 算力 视频渠道（xienlive.com·OctopusAI：MiniMax H3 音视频同步；第217轮；Bearer sk- 鉴权）──
# ⚠ Base URL 填根域（翻译器自拼 /api/v1/video/generate|generate-flf|query）。
# SUANLI_BASE_URL=https://xienlive.com
# SUANLI_API_KEY=

# ── Yali AI Studio 图片渠道（api.yaliai.com；第229轮；Bearer 鉴权，同步单请求 OpenAI Images 形态）──
# ⚠ Base URL 填根域（翻译器自拼 /v1/images/generations|edits）。
# ⚠ 一把 Key 只能调它绑定的那一种「接口类型」（OpenAI Images / Banana·Gemini），错配上游返 403。
#    环境变量只能兜底一类 → 两类都要用时，请在管理端「Yali · OpenAI Images」「Yali · Banana/Gemini」
#    两个渠道里各自填对应的 Key（渠道 apiKey 优先于环境变量）。
# YALI_BASE_URL=https://api.yaliai.com
# YALI_API_KEY=

# ── Skylee 图片渠道（api.808relay.com：GPT Image 2 / Gemini 3 系 / Midjourney 12 款；第230轮；Bearer 鉴权）──
# ⚠ Base URL 填根域不带 /v1（翻译器自拼 /v1/images/generations?async=true、/v1/images/tasks/{id}）。
#    主线异常可临时改 https://api2.808relay.com（Key/模型名/参数不变）。
# SKYLEE_BASE_URL=https://api.808relay.com
# SKYLEE_API_KEY=

# ── congge 图片+视频渠道（congchen.top·聪宸；第233轮；Bearer sk- 鉴权，图片与视频同一把 Key）──
# ⚠ Base URL 填根域不带 /v1（翻译器自拼 /v1/images/generations|edits、/v1/videos）。
# CONGGE_BASE_URL=https://congchen.top
# CONGGE_API_KEY=

# ── BYS 视频渠道（www.boyesir.icu·Boyesir AI；第252轮；Bearer sk- 鉴权，控制台→令牌创建）──
# ⚠ Base URL 填根域不带 /v1（翻译器自拼 /v1/videos/generations 与 /v1/tasks/{task_id}）。
# ⚠ 该渠道只有参考图字段（无参考视频/音频、无首尾帧）——带视频/音频素材的请求会被前置明确拒。
# BYS_BASE_URL=https://www.boyesir.icu
# BYS_API_KEY=

# ── QiQi 视频渠道（pidoi.com·Seedance 官转 API；第255轮；Bearer sk- 鉴权，控制台→令牌创建）──
# ⚠ Base URL 填根域不带 /v1（翻译器自拼 /v1/videos、/v1/videos/{id}、/v1/videos/{id}/content）。
# ⚠ 分辨率编在上游模型名后缀里（seedace-2.0-720p）——文档明示不要再传 resolution，翻译器一律不发。
# ⚠ 用参考音频/视频时上游要求必须同时带至少 1 张参考图（翻译器已前置拒单）。
# QIQI_BASE_URL=https://pidoi.com
# QIQI_API_KEY=

# ── autodl 视频渠道（autodl.art·ComfyUI 工作流：多图参考/文生/首尾帧三工作流；第234轮）──
# ⚠ 鉴权=Authorization **原样 Token 不带 Bearer**（控制台「令牌管理」创建，分组选 ComfyUI）。
# ⚠ Base URL 填根域（翻译器自拼 /api/v1/comfyui/comfyui_workflow/{workflow_id} 与 /result/{task_id}）；
#    三个模型的「上游模型名」=各自工作流的 workflow_id，须在管理端逐模型填入。
# AUTODL_BASE_URL=https://autodl.art
# AUTODL_API_KEY=

# ── 奇迹云 视频渠道（自建 autodl 云实例池 + ComfyUI 直驱：qj933-minimax-h3；第249轮）──
# ⚠ QIJICLOUD_DEV_TOKEN=autodl **开发者Token**（autodl.com 控制台→设置→开发者Token；原样 Authorization 无 Bearer）——
#   与上面 autodl 模式的 ComfyUI 令牌是**两把不同 token**，勿混填。也可改在管理端「奇迹云」渠道填（渠道优先）。
#   实例注册/分组/开关机在管理端「云实例」页；工作流骨架在服务端代码（translators/comfyGraph.ts）。
# QIJICLOUD_BASE_URL=https://www.autodl.art
# QIJICLOUD_DEV_TOKEN=

# ── OSS 对象存储（S3 兼容；资产/项目云备份，公有读直链）──
# 不填则资产退回内存 + /v1/assets/:id/raw（进程重启即丢，仅联调用）。
OSS_ENDPOINT=https://cn-nb1.rains3.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_SECRET_ACCESS_KEY=
OSS_REGION=cn-nb1
# 可选：CDN/自定义域名（默认 https://<bucket>.<endpoint host>）
# OSS_PUBLIC_BASE=
