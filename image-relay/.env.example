# 复制为 .env 并填写，然后用 `set -a; source .env; set +a; node server.js` 启动
# （用 systemd 部署时直接写进 unit 文件的 EnvironmentFile）

# 服务端口
PORT=8787

# 主服务器调用时的鉴权 token，用长随机串（openssl rand -hex 32 生成一个）
RELAY_TOKEN=换成你自己的长随机串

# ===== 阿里云 OSS =====
# 建议单独建一个 RAM 用户，只授予对该 bucket 指定前缀的 PutObject 权限（见 README）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

# 传输加速端点（需先在 OSS 控制台给 bucket 开启"传输加速"）
OSS_ENDPOINT=https://oss-accelerate.aliyuncs.com

# 返回给主服务器的图片地址前缀，一般填绑定到 bucket 的 CDN 域名
PUBLIC_BASE=https://cdn.你们的域名.com

# 允许下载的来源域名（逗号分隔，支持子域匹配）。
# 填上游图片直链的域名，防止节点被当开放代理滥用
ALLOWED_HOSTS=

# 可选：并发下载上限（默认 4）
# MAX_CONCURRENCY=4
# 可选：单文件大小上限，字节（默认 100MB）
# MAX_BYTES=104857600
# 可选：下载空闲超时，毫秒（默认 30000，只要还在收数据就不算超时）
# IDLE_TIMEOUT_MS=30000
